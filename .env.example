# Supabase Configuration
# Copia este archivo a .env y reemplaza con tus credenciales reales

# URL de tu proyecto Supabase
# Obtén esto desde: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Anon Key de tu proyecto Supabase
# Obtén esto desde: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_ANON_KEY=your-anon-key-here

# Opcional: Configuración para API REST existente (si la sigues usando)
API_BASE_URL=http://localhost:4000/api
